#!/usr/bin/env bash
# Runs git fetch/pull/push against origin, passing GH_TOKEN to git for this command only.
# The token is never written to .git/config or the remote URL.
#
# Usage:
#   scripts/git-remote fetch
#   scripts/git-remote pull          # fast-forward the current branch only
#   scripts/git-remote push          # push the current branch (never main)
set -euo pipefail
: "${GH_TOKEN:?GH_TOKEN is not set}"

authed_git() {
  git -c credential.helper= \
    -c 'credential.helper=!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f' \
    "$@"
}

branch="$(git rev-parse --abbrev-ref HEAD)"

case "${1:-}" in
  fetch) authed_git fetch origin ;;
  pull) authed_git pull --ff-only origin "$branch" ;;
  push)
    if [[ "$branch" == "main" ]]; then
      echo "Refusing to push main; open a PR from a feature branch instead" >&2
      exit 1
    fi
    authed_git push origin "HEAD:refs/heads/$branch"
    ;;
  *)
    echo "usage: scripts/git-remote fetch|pull|push" >&2
    exit 2
    ;;
esac
