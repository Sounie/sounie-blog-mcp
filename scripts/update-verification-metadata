#!/usr/bin/env bash
# Regenerates gradle/verification-metadata.xml (ADR 0008), typically for a Dependabot PR that fails
# CI on dependency verification, then commits and pushes it.
#
# New component versions and dropped ones are fine. A changed or added sha256 for an artifact that
# already had one is a supply-chain alarm: the script reports it, restores the old file and stops
# without committing.
#
# Usage:
#   scripts/update-verification-metadata [--no-push] [<branch>]
#     <branch>    fetch and check out this branch first (e.g. a Dependabot branch)
#     --no-push   commit, but don't push
set -euo pipefail
cd "$(dirname "$0")/.."

metadata=gradle/verification-metadata.xml
push=true
branch=""

for arg in "$@"; do
  case "$arg" in
    --no-push) push=false ;;
    -*)
      echo "usage: scripts/update-verification-metadata [--no-push] [<branch>]" >&2
      exit 2
      ;;
    *) branch="$arg" ;;
  esac
done

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Working tree has uncommitted changes; commit or stash them first" >&2
  exit 1
fi

refuse_main() {
  if [[ "$1" == main ]]; then
    echo "Refusing to run on main; use a feature or Dependabot branch" >&2
    exit 1
  fi
}

refuse_main "${branch:-$(git branch --show-current)}"

if [[ -n "$branch" ]]; then
  scripts/git-remote fetch
  # Never let git guess and track the remote branch: recording upstream tracking writes .git/config,
  # which the Claude Code sandbox blocks, and a failed write leaves HEAD on the old branch with the
  # new branch's files staged.
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch --no-guess "$branch"
  else
    git switch --no-track -c "$branch" "origin/$branch"
  fi
  refuse_main "$(git branch --show-current)"
  scripts/git-remote pull
fi

# One line per artifact: "group:name:version artifact sha256[,also-trusted...]". Gradle writes one
# element per line. On a mismatch, --write-verification-metadata keeps the old sha256 and adds the
# new one as <also-trust>, so those count as checksums too.
checksums() {
  awk -F'"' '
    /<component /                { component = $2 ":" $4 ":" $6 }
    /<artifact /                 { artifact = $2 }
    /<sha256 / || /<also-trust / { key = component " " artifact; sums[key] = (key in sums) ? sums[key] "," $2 : $2 }
    END                          { for (key in sums) print key, sums[key] }
  ' "$1"
}

# Temp files rather than process substitution, which the Claude Code sandbox blocks. An explicit
# template, because macOS mktemp otherwise ignores $TMPDIR, which is the only temp dir the sandbox allows.
tmp="${TMPDIR:-/tmp}"
old="$(mktemp "$tmp/verification-metadata.XXXXXX")"
old_sums="$(mktemp "$tmp/verification-metadata.XXXXXX")"
new_sums="$(mktemp "$tmp/verification-metadata.XXXXXX")"
trap 'rm -f "$old" "$old_sums" "$new_sums"' EXIT
cp "$metadata" "$old"

restore() {
  cp "$old" "$metadata"
}

if [[ -z "$(checksums "$old")" ]]; then
  echo "No checksums found in $metadata; refusing to continue" >&2
  exit 1
fi

# The tasks CI runs, plus the shadow jar and its test, so every configuration is resolved.
# --refresh-dependencies: metadata Gradle serves from its cache (e.g. plugin BOMs) is otherwise
# left out, and a clean CI cache would then fail verification.
if ! ./gw --write-verification-metadata sha256 --refresh-dependencies \
  check pitest shadowJar jarTest; then
  restore
  echo "Build failed; $metadata restored, nothing committed" >&2
  exit 1
fi

checksums "$old" >"$old_sums"
checksums "$metadata" >"$new_sums"
changed="$(awk '
  NR == FNR { known[$1 " " $2] = $3; next }
  ($1 " " $2) in known && known[$1 " " $2] != $3 { print $1, $2, "was", known[$1 " " $2], "now", $3 }
' "$old_sums" "$new_sums")"

if [[ -n "$changed" ]]; then
  restore
  {
    echo "STOP: checksums changed for versions that were already verified:"
    echo "$changed"
    echo "A changed checksum without a version change may mean a tampered artifact."
    echo "$metadata restored, nothing committed. Tell the owner."
  } >&2
  exit 1
fi

# Not an alarm, but worth a look: a version that was already verified gained an artifact.
added="$(awk '
  NR == FNR { known[$1 " " $2]; component[$1]; next }
  ($1 in component) && !(($1 " " $2) in known) { print $1, $2 }
' "$old_sums" "$new_sums")"
if [[ -n "$added" ]]; then
  {
    echo "WARNING: new artifacts for versions that already had entries:"
    echo "$added"
  } >&2
fi

if git diff --quiet -- "$metadata"; then
  echo "Verification metadata is already up to date; nothing to commit"
  exit 0
fi

git add "$metadata"
git commit -m "build(deps): update dependency verification metadata" \
  -m "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>" -- "$metadata"

if [[ "$push" == true ]]; then
  scripts/git-remote push
fi
