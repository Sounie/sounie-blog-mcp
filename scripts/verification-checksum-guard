#!/usr/bin/env bash
# Compares two versions of gradle/verification-metadata.xml (ADR 0008). Used by
# scripts/update-verification-metadata and by both jobs of
# .github/workflows/dependabot-verification-metadata.yml.
#
# New component versions and dropped ones are fine. A changed or added checksum for an artifact that
# already had one is a supply-chain alarm. So is any change to the <configuration> section (e.g. a
# new trusted-artifact pattern), or a line Gradle wouldn't write: the comparison reads one element per
# line, so unexpected formatting could hide a changed checksum.
#
# Usage: scripts/verification-checksum-guard <old.xml> <new.xml>
# Exit:  0 nothing already verified changed (a new artifact for a verified version prints a warning)
#        1 alarm: details on stderr
#        2 usage error
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: scripts/verification-checksum-guard <old.xml> <new.xml>" >&2
  exit 2
fi
old="$1"
new="$2"
for file in "$old" "$new"; do
  if [[ ! -f "$file" ]]; then
    echo "No such file: $file" >&2
    exit 2
  fi
done

# Temp files rather than process substitution, which the Claude Code sandbox blocks. An explicit
# template, because macOS mktemp otherwise ignores $TMPDIR, which is the only temp dir the sandbox allows.
tmp="${TMPDIR:-/tmp}"
old_sums="$(mktemp "$tmp/verification-checksum-guard.XXXXXX")"
new_sums="$(mktemp "$tmp/verification-checksum-guard.XXXXXX")"
trap 'rm -f "$old_sums" "$new_sums"' EXIT

alarm() {
  {
    echo "STOP: $1"
    echo "This may mean a tampered artifact or build. Accept nothing; tell the owner."
  } >&2
  exit 1
}

# The line shapes Gradle writes after the <configuration> section, and nothing else.
unexpected="$(sed '1,/^   <\/configuration>$/d' "$new" | grep -nvE '^(   <components>|   </components>|</verification-metadata>|      <component group="[^"]+" name="[^"]+" version="[^"]+">|      </component>|         <artifact name="[^"]+">|         </artifact>|            <sha256 value="[0-9a-f]{64}" origin="Generated by Gradle"/>|            <also-trust value="[0-9a-f]{64}"/>)$' || true)"
if [[ -n "$unexpected" ]]; then
  alarm "$new has lines Gradle doesn't write (line numbers count from after </configuration>):
$unexpected"
fi

# Everything up to </configuration>: the XML declaration, the root element and the trust settings.
header() {
  sed -n '1,/^   <\/configuration>$/p' "$1"
}
if [[ "$(header "$old")" != "$(header "$new")" ]]; then
  alarm "the <configuration> section or root element of $new differs from $old"
fi

# One line per artifact: "group:name:version artifact sha256[,also-trusted...]". On a mismatch,
# --write-verification-metadata keeps the old sha256 and adds the new one as <also-trust>, so those
# count as checksums too.
checksums() {
  awk -F'"' '
    /<component /                { component = $2 ":" $4 ":" $6 }
    /<artifact /                 { artifact = $2 }
    /<sha256 / || /<also-trust / { key = component " " artifact; sums[key] = (key in sums) ? sums[key] "," $2 : $2 }
    END                          { for (key in sums) print key, sums[key] }
  ' "$1"
}

checksums "$old" >"$old_sums"
checksums "$new" >"$new_sums"
if [[ ! -s "$old_sums" ]]; then
  echo "No checksums found in $old; refusing to compare" >&2
  exit 1
fi

changed="$(awk '
  NR == FNR { known[$1 " " $2] = $3; next }
  ($1 " " $2) in known && known[$1 " " $2] != $3 { print $1, $2, "was", known[$1 " " $2], "now", $3 }
' "$old_sums" "$new_sums")"
if [[ -n "$changed" ]]; then
  alarm "checksums changed for versions that were already verified:
$changed"
fi

# Not an alarm, but worth a look: a version that was already verified gained an artifact.
added="$(awk '
  NR == FNR { known[$1 " " $2]; component[$1]; next }
  ($1 in component) && !(($1 " " $2) in known) { print $1, $2 }
' "$old_sums" "$new_sums")"
if [[ -n "$added" ]]; then
  {
    echo "WARNING: new artifacts for versions that already had entries:"
    echo "$added"
  } >&2
fi
